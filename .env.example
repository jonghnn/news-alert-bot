# 로컬 테스트용 비밀값 틀입니다.
# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요.
#   .env 는 .gitignore 에 있어서 GitHub 에 올라가지 않습니다.
#
# GitHub Actions 에서는 이 파일이 아니라 저장소 Secrets 를 씁니다.

# @BotFather 에게 /newbot 해서 받은 토큰
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 아래는 비워두세요. --mode chatid 로 확인한 뒤 채웁니다.
TELEGRAM_CHAT_ID=

# 네이버 소스를 쓸 때만 필요합니다 (선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
